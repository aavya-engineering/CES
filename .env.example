# ====================================================================
# CES Platform Environment Variables
# Copy this file to .env before starting:
#   Linux/macOS: cp .env.example .env
#   Windows:     copy .env.example .env
# ====================================================================

# Database Superuser Password (used for initialization and migrations)
POSTGRES_PASSWORD=

# Least-Privilege Application User Password (used by muster-api at runtime)
APP_DB_PASSWORD=

# Database Name (default: muster_db)
POSTGRES_DB=muster_db

# JWT Secret for signing session tokens (generate a 64+ char random hex string)
JWT_SECRET=

# Token expiration (default: 30m). Portal signs users out after 30 minutes idle.
JWT_EXPIRES_IN=30m

# Address users open in the browser; used in password-reset e-mails.
PUBLIC_URL=http://localhost:8080

# Outbound e-mail for "Forgot password". Empty = no e-mail is sent (an admin
# then resets passwords in Platform / Administration -> Users).
# Example: smtps://user:password@smtp.example.com:465
SMTP_URL=
MAIL_FROM=CES <no-reply@example.com>

# Initial Platform Administrator (created once on first boot if database is empty)
INITIAL_ADMIN_EMAIL=admin@example.com

# Initial Tenant Name for the Administrator
INITIAL_TENANT_NAME=Blue Heron Defense

# Network Binding for Web Container
# Use 127.0.0.1 if running behind Nginx / ZeroSSL reverse proxy on the host
# Use 0.0.0.0 for direct testing without a reverse proxy
HTTP_BIND=127.0.0.1
HTTP_PORT=8080

# Image Tag (optional, default: latest)
CES_VERSION=latest

# Optional: Claude / Anthropic API Key (enables adaptive interview & AI coach)
ANTHROPIC_API_KEY=

# ── SSL & sslip.io Domain ─────────────────────────────────────────────────────
# By default, points to 136.108.118.191.sslip.io (resolves to host IP)
HOST_IP=136.108.118.191
SSLIP_DOMAIN=136.108.118.191.sslip.io

