<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="app.diagrams.net" modified="2026-11-11T18:00:00.000Z" agent="CES docs" version="24.7.17" type="device">
  <diagram id="ces-platform" name="CES platform — as built 2026-11-11">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- title -->
        <mxCell id="title" value="CES — Compliance Evidence System · as built on master (2026-11-11)&lt;br&gt;&lt;font style=&quot;font-size: 11px&quot; color=&quot;#555555&quot;&gt;Three boxes: platform (anywhere) · tenant runner (Windows, inside the customer boundary) · customer Microsoft cloud. Solid = runtime calls, dashed = dev/test only.&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=18;fontStyle=1;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1100" height="50" as="geometry"/>
        </mxCell>

        <!-- Users -->
        <mxCell id="users" value="People (browser)&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;org admin · compliance manager · IT security admin&lt;br&gt;evidence reviewer · senior approver · assessor (read-only)&lt;br&gt;BHD operator · platform admin (no customer data)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;fontStyle=1;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="110" width="300" height="90" as="geometry"/>
        </mxCell>

        <!-- Platform container -->
        <mxCell id="platform" value="PLATFORM — Linux/macOS/Windows, Docker in production · holds engagement state, never a tenant credential (PB-02)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f0fe;strokeColor=#1a73e8;strokeWidth=2;fontSize=12;fontStyle=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="40" y="240" width="760" height="470" as="geometry"/>
        </mxCell>

        <mxCell id="nginx" value="nginx (TLS 443)&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;serves the SPA, proxies /api and /auth&lt;br&gt;dev: vite proxy on :5173&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1a73e8;" vertex="1" parent="1">
          <mxGeometry x="60" y="280" width="200" height="70" as="geometry"/>
        </mxCell>

        <mxCell id="spa" value="Muster portal (React + Vite SPA)&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;ces-muster/src/features/portal · hash routes&lt;br&gt;Onboard · Assess · Plan · Remediate · Evidence · Monitor · Prepare · Admin&lt;br&gt;sidebar = lifecycle/rbac.ts (same matrix as the API)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1a73e8;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="290" y="280" width="320" height="80" as="geometry"/>
        </mxCell>

        <mxCell id="api" value="muster-api (Express + Prisma + zod) :4000&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;app.ts mounts every router with: bearerAuth → requireAction(matrix) → route rules (DP-2, BHD-only, last org_admin)&lt;br&gt;routes/: onboard · systems · assessments · plan · remediation · evidence · monitor · prepare · admin · auth&lt;br&gt;services/: simDiscoveryRun · liveDiscoveryRun · runCaptures · evidenceCatalog · monitorEvaluate · monitorScheduler&lt;br&gt;lib/: prisma.withTenant (RLS) · audit · permissions · openapi · jwt · childEnv&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1a73e8;align=left;spacingLeft=8;verticalAlign=top;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="60" y="390" width="550" height="120" as="geometry"/>
        </mxCell>

        <mxCell id="scheduler" value="Monitor scheduler&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;in-process, MONITOR_SCHEDULER=1&lt;br&gt;per-tenant cadence, system actor&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1a73e8;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="630" y="390" width="150" height="70" as="geometry"/>
        </mxCell>

        <mxCell id="vendored" value="Vendored BHD reference data (read-only, SHA-256 noted)&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;110 controls · SPRS weights · command registry (201 get_commands) · NIST 800-171A evidence catalog release 0 · EMX&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff8e1;strokeColor=#f9a825;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="630" y="470" width="150" height="100" as="geometry"/>
        </mxCell>

        <mxCell id="db" value="PostgreSQL 16 — muster_db&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;app role muster_app NOBYPASSRLS · 24 migrations&lt;br&gt;RLS: tenant_id = current_setting('app.tenant_id'), fail-closed&lt;br&gt;engagements · engine_jobs · assessment_runs/results · plan_actions · poam_items · remediation_runs · evidence_items (content + SHA-256) · monitor_* · implementation_statements · evidence_packages · audit_events · users/roles&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#ffffff;strokeColor=#1a73e8;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="60" y="540" width="550" height="150" as="geometry"/>
        </mxCell>

        <!-- Runner container -->
        <mxCell id="runnerbox" value="TENANT EXECUTION HOST — Windows 10/11 or Server 2022, PowerShell 5.1 · inside the customer boundary · holds the tenant certificate, no platform state" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e6f4ea;strokeColor=#188038;strokeWidth=2;fontSize=12;fontStyle=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="860" y="240" width="420" height="470" as="geometry"/>
        </mxCell>

        <mxCell id="runner" value="Tenant runner — npm run runner (muster-api/src/runner)&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;signs in as bhd_operator (dedicated role planned, G1)&lt;br&gt;poll: GET …/runner/queue → POST claim → execute → POST result&lt;br&gt;discovery lane: runSimDiscovery + captures (≤50 × 2 MB)&lt;br&gt;remediation lane: CES_RUNNER_REMEDIATION_CMD seam (JSON stdin/stdout)&lt;br&gt;invariant: a claimed job always gets a result&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#188038;align=left;spacingLeft=8;verticalAlign=top;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="880" y="280" width="380" height="120" as="geometry"/>
        </mxCell>

        <mxCell id="engines" value="BHD engines (PowerShell)&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;discovery: liveSimSession spawns powershell.exe for the 201 registry reads (read-only, zero-write assertion)&lt;br&gt;Stamper (configuration) · AdminOps (governed admin ops) · EvidenceOps · Evidence Collector — kit CLI entry pending (O3)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#188038;align=left;spacingLeft=8;verticalAlign=top;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="880" y="430" width="380" height="100" as="geometry"/>
        </mxCell>

        <mxCell id="certstore" value="Windows certificate store / DPAPI&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;tenant app certificate, Graph PowerShell modules&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#188038;" vertex="1" parent="1">
          <mxGeometry x="880" y="560" width="380" height="60" as="geometry"/>
        </mxCell>

        <mxCell id="sim" value="tenant-stacksim :4390 (dev/test only)&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;fake M365/Azure · scenario muster-partial · npm run sim&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fdecea;strokeColor=#c5221f;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="880" y="640" width="380" height="50" as="geometry"/>
        </mxCell>

        <!-- Customer cloud -->
        <mxCell id="cloud" value="Customer Microsoft cloud — M365 GCC / GCC High + Azure Government&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;Graph / Exchange / Intune over .us endpoints · reads always; writes only after DP-2 approval + live gate + consent&lt;/font&gt;" style="shape=cloud;whiteSpace=wrap;html=1;fillColor=#f3e8fd;strokeColor=#8430ce;strokeWidth=2;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1320" y="300" width="300" height="200" as="geometry"/>
        </mxCell>

        <!-- Edges -->
        <mxCell id="e1" value="HTTPS · Bearer JWT" style="endArrow=classic;html=1;edgeStyle=orthogonalEdgeStyle;strokeColor=#1a73e8;fontSize=10;" edge="1" parent="1" source="users" target="nginx">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e2" value="/api /auth" style="endArrow=classic;html=1;edgeStyle=orthogonalEdgeStyle;strokeColor=#1a73e8;fontSize=10;" edge="1" parent="1" source="nginx" target="api">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e3" value="static" style="endArrow=classic;html=1;edgeStyle=orthogonalEdgeStyle;strokeColor=#1a73e8;fontSize=10;" edge="1" parent="1" source="nginx" target="spa">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e4" value="Prisma · withTenant sets app.tenant_id per tx" style="endArrow=classic;html=1;edgeStyle=orthogonalEdgeStyle;strokeColor=#1a73e8;fontSize=10;" edge="1" parent="1" source="api" target="db">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e5" value="" style="endArrow=classic;html=1;edgeStyle=orthogonalEdgeStyle;strokeColor=#1a73e8;fontSize=10;" edge="1" parent="1" source="scheduler" target="api">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e6" value="HTTPS pull (outbound only from the customer side)&lt;br&gt;queue → claim → result (envelope + captures)" style="endArrow=classic;startArrow=none;html=1;edgeStyle=orthogonalEdgeStyle;strokeColor=#188038;strokeWidth=2;fontSize=10;" edge="1" parent="1" source="runner" target="api">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="830" y="340"/>
              <mxPoint x="830" y="450"/>
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e7" value="spawn (scrubbed env)" style="endArrow=classic;html=1;edgeStyle=orthogonalEdgeStyle;strokeColor=#188038;fontSize=10;" edge="1" parent="1" source="runner" target="engines">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e8" value="" style="endArrow=classic;html=1;edgeStyle=orthogonalEdgeStyle;strokeColor=#188038;fontSize=10;dashed=1;" edge="1" parent="1" source="engines" target="certstore">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e9" value="Graph / PowerShell (.us)" style="endArrow=classic;html=1;edgeStyle=orthogonalEdgeStyle;strokeColor=#8430ce;strokeWidth=2;fontSize=10;" edge="1" parent="1" source="engines" target="cloud">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e10" value="PSModulePath shims → facade" style="endArrow=classic;html=1;edgeStyle=orthogonalEdgeStyle;strokeColor=#c5221f;dashed=1;fontSize=10;" edge="1" parent="1" source="engines" target="sim">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e11" value="in-process engine when the API itself is on Windows (CES_ENGINE_LOCAL)" style="endArrow=classic;html=1;edgeStyle=orthogonalEdgeStyle;strokeColor=#188038;dashed=1;fontSize=10;" edge="1" parent="1" source="api" target="engines">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="830" y="500"/>
              <mxPoint x="830" y="480"/>
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- Legend / notes -->
        <mxCell id="notes" value="&lt;b&gt;Guardrails the design enforces&lt;/b&gt;&lt;br&gt;PB-01 platform_admin reads no customer data (platformAdminFence)&lt;br&gt;PB-02 no secrets in run parameters, logs, responses, child env&lt;br&gt;DP-2 set-commands need a second person; requester ≠ approver&lt;br&gt;Live gate re-checked at request → execute → claim (LIVE_DISABLED)&lt;br&gt;GR1 an all-failed read records nothing (engine_unavailable)&lt;br&gt;&lt;br&gt;&lt;b&gt;Open (docs 47–50)&lt;/b&gt;: dedicated runner role + signed results · MFA · live grants on the runner · kit CLI for Stamper/AdminOps · WORM evidence store · SIEM" style="text;html=1;align=left;verticalAlign=top;fontSize=10;strokeColor=#999999;fillColor=#fafafa;rounded=1;spacingLeft=8;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="40" y="730" width="760" height="120" as="geometry"/>
        </mxCell>

        <mxCell id="flow" value="&lt;b&gt;Assessment flow&lt;/b&gt;&lt;br&gt;1 compliance manager: Run assessment → engine_jobs(queued)&lt;br&gt;2 runner claims → PowerShell walks 201 reads → readiness-result envelope + captures&lt;br&gt;3 API validates → assessment_runs + 110 results + SPRS → captures become draft evidence (SHA-256)&lt;br&gt;4 portal: Readiness · Gaps · Plan actions · Remediate (simulate → approve → live) · Evidence review · Prepare package · Monitor" style="text;html=1;align=left;verticalAlign=top;fontSize=10;strokeColor=#999999;fillColor=#fafafa;rounded=1;spacingLeft=8;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="860" y="730" width="760" height="120" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
