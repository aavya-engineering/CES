# ====================================================================
# CES Platform — STAGING / UAT server (Docker Compose behind Nginx + TLS)
# Copy on the server:  cp env/staging.env.example .env   → fill the secrets →  sudo ./deploy.sh
# Never commit .env. chmod 600 .env after filling it.
# See docs/ENVIRONMENTS.md for the key-by-key explanation.
# ====================================================================

CES_ENV=staging
NODE_ENV=production

# ── Database ──────────────────────────────────────────────────────────────────
# Generate on the server: openssl rand -hex 24   (different values from prod!)
POSTGRES_PASSWORD=
APP_DB_PASSWORD=
POSTGRES_DB=muster_db

# ── Sessions ──────────────────────────────────────────────────────────────────
# Generate: openssl rand -hex 48
JWT_SECRET=
# Same policy as production so UAT tests the real behaviour (30 min idle sign-out).
JWT_EXPIRES_IN=30m

# ── Addresses ────────────────────────────────────────────────────────────────
# Behind the host Nginx/ZeroSSL proxy: bind to localhost only.
HTTP_BIND=127.0.0.1
HTTP_PORT=8080
# The address testers open — used in password-reset e-mails. MUST be https.
PUBLIC_URL=https://staging.ces.example.com      # TBD: real staging host name

# ── Mail ─────────────────────────────────────────────────────────────────────
# Real SMTP so "Forgot password" can be tested end to end.
# Example: smtps://user:password@smtp.example.com:465
SMTP_URL=
MAIL_FROM=CES Staging <no-reply@blueherondefense.com>

# ── First administrator (created once on an empty database) ─────────────────
INITIAL_ADMIN_EMAIL=vaibhav.pathak@aavya.com
INITIAL_TENANT_NAME=Blue Heron Defense
# Extra named users: copy deploy/users.seed.example.json → deploy/users.seed.json

# ── Logging / diagnostics ────────────────────────────────────────────────────
LOG_LEVEL=info
LOG_FORMAT=json
# Swagger UI on in staging (sign-in required).
API_DOCS=1

# ── Optional integrations ────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
# Deploy a git tag, not "latest", so a rollback is one line.
CES_VERSION=latest

# ── TLS proxy (deploy.sh / setup-ssl.sh) ────────────────────────────────────
HOST_IP=                                        # TBD: staging server public IP
SSLIP_DOMAIN=                                   # e.g. <ip>.sslip.io or the real host name
