# ====================================================================
# CES Platform — DEVELOPMENT (local laptop, Docker Compose)
# Copy:  cp env/development.env.example .env   then:  ./start.sh
# Nothing here is secret-safe for a server. Never commit .env.
# See docs/ENVIRONMENTS.md for the key-by-key explanation.
# ====================================================================

CES_ENV=development
NODE_ENV=development

# ── Database ──────────────────────────────────────────────────────────────────
# Superuser (migrations) and least-privilege app role (runtime, RLS on).
# Generate: openssl rand -hex 24
POSTGRES_PASSWORD=
APP_DB_PASSWORD=
POSTGRES_DB=muster_db

# ── Sessions ──────────────────────────────────────────────────────────────────
# Generate: openssl rand -hex 48
JWT_SECRET=
# Longer in dev so you are not signed out while debugging.
JWT_EXPIRES_IN=8h

# ── Addresses ────────────────────────────────────────────────────────────────
# Direct access (no reverse proxy) on the laptop.
HTTP_BIND=0.0.0.0
HTTP_PORT=8080
PUBLIC_URL=http://localhost:8080

# ── Mail ─────────────────────────────────────────────────────────────────────
# Empty = password-reset mails are printed to the api log instead of sent.
SMTP_URL=
MAIL_FROM=CES Dev <no-reply@localhost>

# ── First administrator (created once on an empty database) ─────────────────
INITIAL_ADMIN_EMAIL=vaibhav.pathak@aavya.com
INITIAL_TENANT_NAME=Blue Heron Defense

# ── Logging / diagnostics ────────────────────────────────────────────────────
# debug | info | warn | error        pretty | json
LOG_LEVEL=debug
LOG_FORMAT=pretty
# Swagger UI at /api-docs (1 = on). Always on in development.
API_DOCS=1

# ── Optional integrations ────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
CES_VERSION=dev

# Not used in development (no TLS proxy on the laptop); kept so deploy.sh is happy.
HOST_IP=127.0.0.1
SSLIP_DOMAIN=localhost
