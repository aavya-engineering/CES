# muster-api — run the API directly on the laptop (no Docker):
#   cp ../../env/muster-api.development.env.example .env
#   createdb muster_db   (or: docker run -d -p 5432:5432 -e POSTGRES_PASSWORD=dev postgres:16-alpine)
#   psql -d muster_db -v app_password="'dev'" -f scripts/bootstrap-app-role.sql
#   npm run migrate:deploy && npm run seed:ces-shared && npm run dev
# Portal: cd .. && npm run dev   (Vite on http://localhost:5173, CORS allowlisted below)

CES_ENV=development
NODE_ENV=development
PORT=4000

# The app role MUST be muster_app (never postgres / BYPASSRLS) — tenant isolation depends on RLS.
DATABASE_URL=postgresql://muster_app:dev@localhost:5432/muster_db

# Any long random value is fine locally; must be set or the server refuses to start.
JWT_SECRET=dev-only-change-me-0123456789abcdef0123456789abcdef
JWT_EXPIRES_IN=8h

# Vite dev (5173) and preview (4173) origins.
MUSTER_CORS_ORIGINS=http://localhost:5173,http://localhost:4173
MUSTER_PUBLIC_URL=http://localhost:5173
# Empty = password-reset mails are printed to the console.
MUSTER_SMTP_URL=
MUSTER_MAIL_FROM=CES Dev <no-reply@localhost>

LOG_LEVEL=debug
LOG_FORMAT=pretty
API_DOCS=1

# Sign-in lockout (NIST 3.1.8) — defaults are fine; relax only when load-testing.
# MUSTER_LOGIN_MAX_FAILURES=5
# MUSTER_LOGIN_MAX_FAILURES_PER_CLIENT=20
# MUSTER_LOGIN_WINDOW_MS=900000

# Optional: adaptive interview / coach. Empty = static interview.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=

# Pipeline storage (Stamper plan-data). Default on macOS/Linux: <cwd>/ces-pipeline
CES_PIPELINE_ROOT=
CES_STRICT_SECRETS=
GRAPH_BASE_URL=
REASSESS_DAYS=
# Leave unset (P2 gate): RECIPES_SELF_SERVE=
