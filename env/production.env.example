# ====================================================================
# CES Platform — PRODUCTION server (Docker Compose behind Nginx + TLS)
# Copy on the server:  cp env/production.env.example .env   → fill the secrets →  sudo ./deploy.sh
# Never commit .env. chmod 600 .env after filling it. Back it up with the DB (DEPLOYMENT.md §8).
# See docs/ENVIRONMENTS.md for the key-by-key explanation.
# ====================================================================

CES_ENV=production
NODE_ENV=production

# ── Database ──────────────────────────────────────────────────────────────────
# Generate on the server: openssl rand -hex 24   (unique to this server)
POSTGRES_PASSWORD=
APP_DB_PASSWORD=
POSTGRES_DB=muster_db

# ── Sessions ──────────────────────────────────────────────────────────────────
# Generate: openssl rand -hex 48. Rotating it signs everyone out.
JWT_SECRET=
# 30 minutes idle sign-out (decision: login page / session timeout).
JWT_EXPIRES_IN=30m

# ── Addresses ────────────────────────────────────────────────────────────────
# Behind the host Nginx/ZeroSSL proxy: bind to localhost only. Never 0.0.0.0 here.
HTTP_BIND=127.0.0.1
HTTP_PORT=8080
# The address users open — used in password-reset e-mails. MUST be https.
PUBLIC_URL=https://136.108.118.191.sslip.io     # TBD: replace with the real domain when BHD provides one

# ── Mail ─────────────────────────────────────────────────────────────────────
# Required in production, otherwise "Forgot password" sends nothing.
# Example: smtps://user:password@smtp.example.com:465
SMTP_URL=
MAIL_FROM=CES <no-reply@blueherondefense.com>

# ── First administrator (created once on an empty database) ─────────────────
# One-time password is written to deploy/output/initial-admin.txt; must change at first sign-in.
INITIAL_ADMIN_EMAIL=msutton@blueherondefense.com
INITIAL_TENANT_NAME=Blue Heron Defense
# Extra named users: copy deploy/users.seed.example.json → deploy/users.seed.json

# ── Logging / diagnostics ────────────────────────────────────────────────────
LOG_LEVEL=info
LOG_FORMAT=json
# Swagger UI OFF in production (set to 1 only temporarily, behind sign-in).
API_DOCS=0

# ── Optional integrations ────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
# Always deploy a git tag (e.g. v2.3.0) so a rollback is `CES_VERSION=v2.2.3 ./deploy.sh`.
CES_VERSION=latest

# ── TLS proxy (deploy.sh / setup-ssl.sh) ────────────────────────────────────
HOST_IP=136.108.118.191
SSLIP_DOMAIN=136.108.118.191.sslip.io
