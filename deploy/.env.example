# CES deployment settings. Copy to .env (start.sh / start.bat do it for you and
# fill the three secrets with random values). Never commit .env.

# Secrets — long random values, different on every server.
POSTGRES_PASSWORD=
APP_DB_PASSWORD=
JWT_SECRET=

# First platform administrator, created once on an empty database. Its one-time
# password is written to deploy/output/initial-admin.txt.
INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_TENANT_NAME=Blue Heron Defense

# Port the portal listens on. Put HTTPS in front of it (see DEPLOYMENT.md §6).
# HTTP_BIND=127.0.0.1 keeps it reachable only from the server itself (use with a local TLS proxy).
HTTP_PORT=8080
HTTP_BIND=0.0.0.0

# Address users open in the browser; used in password-reset e-mails.
PUBLIC_URL=http://localhost:8080

# Outbound e-mail for "Forgot password". Empty = no e-mail is sent (an admin
# then resets passwords in Platform / Administration → Users).
# Example: smtps://user:password@smtp.example.com:465
SMTP_URL=
MAIL_FROM=CES <no-reply@example.com>

# Sign-in token lifetime. The portal also signs users out after 30 minutes idle.
JWT_EXPIRES_IN=30m

# Image tag, e.g. the git tag you deploy.
CES_VERSION=latest

# Optional: Claude API key for the adaptive interview and coach (empty = static interview).
ANTHROPIC_API_KEY=

# ── SSL & sslip.io Domain ─────────────────────────────────────────────────────
# Domain resolving directly to host IP (136.108.118.191)
HOST_IP=136.108.118.191
SSLIP_DOMAIN=136.108.118.191.sslip.io

